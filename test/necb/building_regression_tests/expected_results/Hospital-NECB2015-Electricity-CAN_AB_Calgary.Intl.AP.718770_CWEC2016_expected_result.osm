  sys3mixedshrnonescdxshcessfcvzhbezcnonesrfnone42OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}<23.9 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}>1.7, !- Program Line 1
