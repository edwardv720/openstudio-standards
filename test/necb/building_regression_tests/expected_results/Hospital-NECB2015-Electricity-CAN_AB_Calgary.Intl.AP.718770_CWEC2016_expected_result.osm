  SET {4048db04-02e9-4adc-a490-b45e453f9fa5} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}<23.9 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}>1.7, !- Program Line 4
  SET {53812c50-f664-4c8b-9fe8-d2bebe1fdcc4} = 29.4, !- Program Line 5
  SET {4048db04-02e9-4adc-a490-b45e453f9fa5} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}<23.9 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}>1.7, !- Program Line 7
  SET {53812c50-f664-4c8b-9fe8-d2bebe1fdcc4} = 29.4, !- Program Line 8
  SET {4048db04-02e9-4adc-a490-b45e453f9fa5} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}<23.9 && {8bee5e1a-8359-4d5d-bdcf-92b099c8f6de}>1.7, !- Program Line 10
  SET {53812c50-f664-4c8b-9fe8-d2bebe1fdcc4} = 29.4, !- Program Line 11
  SET {4048db04-02e9-4adc-a490-b45e453f9fa5} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {53812c50-f664-4c8b-9fe8-d2bebe1fdcc4} = NULL, !- Program Line 14
  SET {4048db04-02e9-4adc-a490-b45e453f9fa5} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

